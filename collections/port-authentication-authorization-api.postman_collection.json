          "name": "Rotate a user's credentials",
          "request": {
            "name": "Rotate a user's credentials",
            "description": {
              "content": "This route allows you to rotate a user's credentials and generate new ones.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "rotate-credentials",
                ":user_email"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "user_email",
                  "description": "(Required) The email address of the user you want to operate on."
                }
              ]
