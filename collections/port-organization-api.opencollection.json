      "items": [
        {
          "info": {
            "name": "Get organization details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/organization",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "This route allows you to fetch the details of your Port organization, such as its name, id, and hidden blueprints."
        },
        {
          "info": {
            "name": "Change organization details",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/organization",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "This route allows you to change the details of your Port organization, such as its name and hidden blueprints."
        },
        {
          "info": {
